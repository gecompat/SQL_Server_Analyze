__pycache__/
*.py[cod]
.pytest_cache/
*.backup

# Generated installer output (directory-local guard exists as well).
Code/Install/generated/*.generated.sql

# QuickStart local runtime configuration.
QuickStart/Docker/.env
QuickStart/Docker/.env.*.tmp
QuickStart/Docker/*.log
