{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gecompat/SQL_Server_Analyze/TestLab/Schemas/analyze-example.schema.json",
  "title": "SQL Server Analyze example catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "examples"],
  "properties": {
    "schemaVersion": {
      "const": "1.0"
    },
    "examples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/example"
      }
    }
  },
  "$defs": {
    "example": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "scenarioId",
        "sqlVersions",
        "providers",
        "resourceProfile",
        "database",
        "primaryAnalyzer",
        "findingCode",
        "workerCount",
        "workerStartLeadSeconds",
        "timeoutSeconds",
        "safetyClass"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9-]{2,39}$"
        },
        "title": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120
        },
        "scenarioId": {
          "type": "string",
          "pattern": "^LAB-[A-Z0-9]+-[0-9]{3}$"
        },
        "sqlVersions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["2019", "2022", "2025"]
          }
        },
        "providers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["docker", "podman"]
          }
        },
        "resourceProfile": {
          "enum": ["compact", "standard", "performance"]
        },
        "database": {
          "const": "LabAnalyze"
        },
        "primaryAnalyzer": {
          "type": "string",
          "pattern": "^USP_[A-Za-z0-9]+$"
        },
        "findingCode": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{2,119}$"
        },
        "workerCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "workerScripts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^TestLab/Examples/[A-Za-z0-9_-]+/[A-Za-z0-9_.-]+\\.sql$"
          }
        },
        "workerStartLeadSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 30,
          "maximum": 600
        },
        "safetyClass": {
          "enum": ["LOW", "MEDIUM"]
        }
      }
    }
  }
}
